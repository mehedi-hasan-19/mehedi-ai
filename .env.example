# GEMINI_API_KEY: Required for server-side Google Gemini AI Brain calls.
# AI Studio automatically injects this at runtime from user secrets.
# In Google Cloud Run, configure this as an environment variable or Secret Manager secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional default Gemini model name (defaults to gemini-3.1-flash-lite).
GEMINI_MODEL="gemini-3.1-flash-lite"

# PORT: Server HTTP port (defaults to 3000 locally; Cloud Run injects PORT automatically).
PORT="3000"

# NODE_ENV: Set to "production" in Cloud Run so Express serves the built /dist bundle.
NODE_ENV="production"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# N8N_WEBHOOK_URL: Optional server-side n8n webhook URL for workflow automation.
N8N_WEBHOOK_URL=""

# N8N_API_KEY: Optional server-side secret header for n8n authentication.
N8N_API_KEY=""
